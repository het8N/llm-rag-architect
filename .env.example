# Copy to .env and adjust. Every variable is optional: the defaults below are
# the ones baked into src/rag_architect/config.py and give a working local
# setup (Qdrant in Docker + Ollama). Uncomment only what you change.
#
# Naming: RAG_<SECTION>__<FIELD>, with a double underscore between the
# sub-model and its field. A key without the RAG_ prefix is silently ignored.

# --- Application -------------------------------------------------------------
# RAG_APP_NAME=LLM-RAG-Architect
# RAG_ENVIRONMENT=development          # development | staging | production

# --- Chunking ----------------------------------------------------------------
# RAG_CHUNKING__CHUNK_SIZE=512         # tokens, 128..2048
# RAG_CHUNKING__CHUNK_OVERLAP=64       # tokens, must stay < CHUNK_SIZE
# RAG_CHUNKING__ENCODING_NAME=cl100k_base

# --- Embeddings --------------------------------------------------------------
# RAG_EMBEDDING__MODEL_NAME=BAAI/bge-small-en-v1.5
# RAG_EMBEDDING__BATCH_SIZE=32
# RAG_EMBEDDING__CACHE_DIR=.cache/fastembed

# --- Vector store (Qdrant) ---------------------------------------------------
# RAG_VECTOR_STORE__URL=http://localhost:6333
# RAG_VECTOR_STORE__COLLECTION_NAME=pl_reports
# RAG_VECTOR_STORE__TOP_K=5
# RAG_VECTOR_STORE__TIMEOUT_S=10.0
# Required by Qdrant Cloud only; leave unset for a local container.
# RAG_VECTOR_STORE__API_KEY=

# --- LLM (OpenAI-compatible API) ---------------------------------------------
# Local default: Ollama. Production: Groq, by overriding BASE_URL, MODEL and
# API_KEY only -- no code change.
#   RAG_LLM__BASE_URL=https://api.groq.com/openai/v1
#   RAG_LLM__MODEL=llama-3.3-70b-versatile
# RAG_LLM__BASE_URL=http://localhost:11434/v1
# RAG_LLM__MODEL=qwen2.5:7b
# RAG_LLM__TEMPERATURE=0.0
# RAG_LLM__MAX_TOKENS=512
# RAG_LLM__TIMEOUT_S=60.0
# Not needed by Ollama; required by Groq.
# RAG_LLM__API_KEY=

# --- HTTP API ----------------------------------------------------------------
# RAG_API__HOST=0.0.0.0
# RAG_API__PORT=8000
# Header key clients must present. Unset means the API is unauthenticated:
# acceptable locally, never in production.
# RAG_API__API_KEY=
